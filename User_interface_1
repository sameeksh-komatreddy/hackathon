              <input type="range" min="5" max="25" value="12" id="sliderBlink">
            </div>
            <div class="slider-row" style="margin-bottom:4px;">
              <div class="sr-top"><span>Minimum screen distance</span><b id="valDist">40cm</b></div>
              <input type="range" min="20" max="80" value="40" id="sliderDist">
            </div>
          </div>

          <div class="card settings-card"><div class="card-corner tl"></div><div class="card-corner br"></div>
            <h3>Notifications</h3>
            <p class="sc-sub">Choose how and when BackTrack interrupts you.</p>
            <div class="select-row">
              <label>Reminder frequency</label>
              <select><option>Every 10 minutes</option><option selected>Every 20 minutes</option><option>Every 30 minutes</option><option>Only on threshold breach</option></select>
            </div>
            <div class="select-row" style="margin-bottom:0;">
              <label>Quiet hours</label>
              <select><option>None</option><option selected>7:00 PM – 8:00 AM</option><option>Custom range</option></select>
            </div>
          </div>

          <div class="card settings-card"><div class="card-corner tl"></div><div class="card-corner br"></div>
            <h3>Appearance</h3>
            <p class="sc-sub">Pick the display theme for the whole app.</p>
            <div class="theme-options">
              <div class="theme-opt selected"><div class="swatch analytical"></div><span>Analytical Dark</span></div>
              <div class="theme-opt"><div class="swatch midnight"></div><span>Midnight Blue</span></div>
            </div>
          </div>
        </div>

        <button class="save-btn" id="saveSettingsBtn">Save preferences</button>
      </section>

    </main>
  </div>
</div>

<!-- Toast -->
<div id="toast">
  <div class="t-icon">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ff5c6a" stroke-width="2"><path d="M12 9v4"/><path d="M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
  </div>
  <div class="t-text"><b>Posture threshold reached</b><span>You've been leaning forward for 45 seconds — try straightening up.</span></div>
  <button class="t-close" id="toastClose">✕</button>
</div>

<script>
/* ============ AMBIENT NETWORK BACKGROUND ============ */
const canvas = document.getElementById('bgCanvas');
const ctx = canvas.getContext('2d');
let w, h, nodes = [];
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const mouse = { x: -9999, y: -9999 };

function resize(){
  w = canvas.width = window.innerWidth;
  h = canvas.height = window.innerHeight;
  const density = Math.min(70, Math.floor((w*h)/26000));
  nodes = Array.from({length: density}, () => ({
    x: Math.random()*w, y: Math.random()*h,
    vx: (Math.random()-0.5)*0.25, vy: (Math.random()-0.5)*0.25
  }));
}
window.addEventListener('resize', resize);
window.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });
window.addEventListener('mouseleave', () => { mouse.x = -9999; mouse.y = -9999; });
resize();

let t0 = performance.now();
function tick(now){
  const elapsed = (now || performance.now()) - t0;
  // slow ambient shimmer so the grid reads as "alive" even with no cursor input
  const ambientPulse = 0.65 + 0.35*Math.sin(elapsed*0.0006);

  ctx.clearRect(0,0,w,h);
  for(const n of nodes){
    n.x += n.vx; n.y += n.vy;
    if(n.x < 0 || n.x > w) n.vx *= -1;
    if(n.y < 0 || n.y > h) n.vy *= -1;
    const dx = mouse.x - n.x, dy = mouse.y - n.y;
    const distM = Math.sqrt(dx*dx + dy*dy);
    if(distM < 160){ n.x -= dx*0.0025; n.y -= dy*0.0025; }
  }
  for(let i=0;i<nodes.length;i++){
    for(let j=i+1;j<nodes.length;j++){
      const a = nodes[i], b = nodes[j];
      const dx = a.x-b.x, dy = a.y-b.y;
      const dist = Math.sqrt(dx*dx+dy*dy);
      if(dist < 155){
        const distToMouse = Math.min(
          Math.hypot(a.x-mouse.x,a.y-mouse.y),
          Math.hypot(b.x-mouse.x,b.y-mouse.y)
        );
        const proximity = Math.max(0, 1 - distToMouse/260);
        const baseAlpha = (1 - dist/155) * 0.24 * ambientPulse;
        const alpha = baseAlpha + proximity*0.3;
        ctx.strokeStyle = `rgba(${46+proximity*30},${125+proximity*90},255,${alpha})`;
        ctx.lineWidth = 1.1;
        ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
      }
    }
  }
  for(const n of nodes){
    const distToMouse = Math.hypot(n.x-mouse.x, n.y-mouse.y);
    const proximity = Math.max(0, 1 - distToMouse/220);
    ctx.beginPath();
    ctx.arc(n.x, n.y, 1.6 + proximity*1.6, 0, Math.PI*2);
    ctx.fillStyle = `rgba(80,153,255,${0.55*ambientPulse + proximity*0.4})`;
    ctx.fill();
  }
  if(!reduceMotion) requestAnimationFrame(tick);
}
tick(t0);
if(reduceMotion){ /* draw one static frame only, already done above */ }

/* ============ LOGIN / SIGNUP ============ */
function enterApp(){
  document.getElementById('login-screen').classList.add('hidden');
  document.getElementById('app-shell').classList.remove('hidden');
}
document.getElementById('loginForm').addEventListener('submit', function(e){
  e.preventDefault();
  enterApp();
});
// Fallback: also fire on a direct click, in case a submit event ever gets swallowed
document.getElementById('loginSubmitBtn').addEventListener('click', function(e){
  e.preventDefault();
  enterApp();
});
document.getElementById('logoutBtn').addEventListener('click', function(){
  document.getElementById('app-shell').classList.add('hidden');
  document.getElementById('login-screen').classList.remove('hidden');
});

let isSignup = false;
const toggleSignupBtn = document.getElementById('toggleSignup');
const loginHeading = document.getElementById('loginHeading');
const loginSub = document.getElementById('loginSub');
const loginSubmitBtn = document.getElementById('loginSubmitBtn');
const nameFieldWrap = document.getElementById('nameFieldWrap');

toggleSignupBtn.addEventListener('click', function(){
  isSignup = !isSignup;
  if(isSignup){
    loginHeading.textContent = 'Create your account';
    loginSub.textContent = 'Set up BackTrack to start tracking posture and eye strain.';
    loginSubmitBtn.textContent = 'Create account';
    nameFieldWrap.classList.remove('hidden');
    toggleSignupBtn.textContent = 'Sign in instead';
    toggleSignupBtn.parentElement.firstChild.textContent = 'Already have an account? ';
  } else {
    loginHeading.textContent = 'Sign in';
    loginSub.textContent = 'Track posture and eye strain with precision, session by session.';
    loginSubmitBtn.textContent = 'Sign in';
    nameFieldWrap.classList.add('hidden');
    toggleSignupBtn.textContent = 'Create an account';
    toggleSignupBtn.parentElement.firstChild.textContent = 'New to BackTrack? ';
  }
});

/* ============ TAB NAVIGATION ============ */
const titles = {
  history: ["History", "Review sessions and long-term trends."],
  record: ["Record", "Capture a new session from both camera angles."],
  export: ["Export", "Turn your history into a report you can share."],
  settings: ["Settings", "Tune thresholds, reminders, and appearance."]
};
document.querySelectorAll('.nav-item').forEach(btn => {
  btn.addEventListener('click', function(){
    document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
    this.classList.add('active');
    const tab = this.dataset.tab;
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
    document.getElementById('panel-'+tab).classList.add('active');
    document.getElementById('pageTitle').textContent = titles[tab][0];
    document.getElementById('pageSub').textContent = titles[tab][1];
  });
});

/* ============ CLOCK ============ */
function updateClock(){
  const d = new Date();
  document.getElementById('clockText').textContent = d.toLocaleTimeString('en-US', {hour12:false});
}
updateClock(); setInterval(updateClock, 1000);

/* ============ RECORD BUTTON + TIMER ============ */
let recording = false, seconds = 0, timerInterval = null;
const recordBtn = document.getElementById('recordBtn');
const recordBtnText = document.getElementById('recordBtnText');
const recTimer = document.getElementById('recTimer');
const lmElapsed = document.getElementById('lmElapsed');

function fmt(s){
  const hh = String(Math.floor(s/3600)).padStart(2,'0');
  const mm = String(Math.floor((s%3600)/60)).padStart(2,'0');
  const ss = String(s%60).padStart(2,'0');
  return hh+':'+mm+':'+ss;
}
function fmtShort(s){
  const mm = String(Math.floor(s/60)).padStart(2,'0');
  const ss = String(s%60).padStart(2,'0');
  return mm+':'+ss;
}

recordBtn.addEventListener('click', function(){
  recording = !recording;
  if(recording){
    recordBtn.classList.add('recording');
    recordBtnText.textContent = 'Stop recording';
    timerInterval = setInterval(() => {
      seconds++;
      recTimer.textContent = fmt(seconds);
      lmElapsed.textContent = fmtShort(seconds);
    }, 1000);
    setTimeout(() => { if(recording) showToast(); }, 8000);
  } else {
    recordBtn.classList.remove('recording');
    recordBtnText.textContent = 'Start recording';
    clearInterval(timerInterval);
  }
});

/* ============ TOAST ============ */
const toast = document.getElementById('toast');
function showToast(){
  toast.classList.add('show');
  clearTimeout(toast._hideTimer);
  toast._hideTimer = setTimeout(() => toast.classList.remove('show'), 6000);
}
document.getElementById('toastClose').addEventListener('click', () => toast.classList.remove('show'));

/* ============ EXPORT: CHECKBOXES + PDF BUTTON STATE ============ */
const checks = ['chkPosture','chkEye','chkTrend','chkSessions'].map(id => document.getElementById(id));
const pdfBtn = document.getElementById('pdfBtn');
function refreshPdfBtn(){
  const anyChecked = checks.some(c => c.checked);
  pdfBtn.disabled = !anyChecked;
}
checks.forEach(c => c.addEventListener('change', refreshPdfBtn));
refreshPdfBtn();
pdfBtn.addEventListener('click', function(){
  if(pdfBtn.disabled) return;
  const original = pdfBtn.innerHTML;
  pdfBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Report generated';
  setTimeout(() => pdfBtn.innerHTML = original, 2200);
});

/* ============ SETTINGS SLIDERS ============ */
function bindSlider(sliderId, labelId, suffix){
  const slider = document.getElementById(sliderId);
  const label = document.getElementById(labelId);
  slider.addEventListener('input', () => { label.textContent = slider.value + suffix; });
}
bindSlider('sliderNeck','valNeck','°');
bindSlider('sliderShoulder','valShoulder','°');
bindSlider('sliderSustain','valSustain','s');
bindSlider('sliderBlink','valBlink','/min');
bindSlider('sliderDist','valDist','cm');

/* ============ THEME OPTIONS ============ */
document.querySelectorAll('.theme-opt').forEach(opt => {
  opt.addEventListener('click', function(){
    document.querySelectorAll('.theme-opt').forEach(o => o.classList.remove('selected'));
    this.classList.add('selected');
  });
});

/* ============ SAVE SETTINGS ============ */
document.getElementById('saveSettingsBtn').addEventListener('click', function(){
  const original = this.textContent;
  this.textContent = 'Preferences saved ✓';
  setTimeout(() => this.textContent = original, 2000);
});
</script>

</body>
</html>
