<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BackTrack — Posture Telemetry</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ============ TOKENS ============ */
:root{
  --ink-950:#04070b;
  --ink-900:#080f18;
  --ink-850:#0b1420;
  --ink-800:#0f1b29;
  --ink-750:#132234;
  --line-800:#152233;
  --line-700:#1e3149;
  --line-600:#294464;
  --blue-600:#1c56cf;
  --blue-500:#2e7dff;
  --blue-400:#5099ff;
  --blue-300:#84b8ff;
  --cyan-400:#49d3e0;
  --text-100:#e8eff8;
  --text-300:#aebdcf;
  --text-500:#6d7f96;
  --text-600:#4d5c70;
  --alert-500:#ff5c6a;
  --alert-400:#ff8790;
  --good-500:#39d6a0;
  --font-display:'Space Grotesk', sans-serif;
  --font-mono:'JetBrains Mono', monospace;
  --font-body:'Inter', sans-serif;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:var(--ink-950);
  color:var(--text-100);
  font-family:var(--font-body);
  min-height:100vh;
  overflow-x:hidden;
  position:relative;
}
::selection{background:var(--blue-600);color:#fff;}
:focus-visible{outline:2px solid var(--blue-400);outline-offset:2px;}
button{font-family:inherit;cursor:pointer;}
input,select{font-family:inherit;}

@media (prefers-reduced-motion: reduce){
  *{animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important;}
}

/* ============ AMBIENT BACKGROUND ============ */
#bgCanvas{
  position:fixed;
  inset:0;
  width:100%;
  height:100%;
  z-index:0;
  pointer-events:none;
}
.grain{
  position:fixed;inset:0;z-index:1;pointer-events:none;
  background-image:radial-gradient(circle at 1px 1px, rgba(255,255,255,0.025) 1px, transparent 0);
  background-size:3px 3px;
  mix-blend-mode:overlay;
}

/* ============ SCAFFOLD ============ */
#app{position:relative;z-index:2;min-height:100vh;}
.hidden{display:none !important;}

/* ============ LOGIN ============ */
#login-screen{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:24px;
}
.login-card{
  width:100%;
  max-width:400px;
  background:linear-gradient(180deg, rgba(15,27,41,.9), rgba(8,15,24,.9));
  border:1px solid var(--line-700);
  border-radius:14px;
  padding:38px 34px 30px;
  position:relative;
  box-shadow:0 30px 80px -20px rgba(0,0,0,.7), 0 0 0 1px rgba(46,125,255,.04);
  backdrop-filter:blur(6px);
}
.login-card::before,.login-card::after{
  content:'';position:absolute;width:14px;height:14px;
  border:1px solid var(--blue-500);opacity:.6;
}
.login-card::before{top:-1px;left:-1px;border-right:none;border-bottom:none;}
.login-card::after{bottom:-1px;right:-1px;border-left:none;border-top:none;}
.brand-mark{display:flex;align-items:center;gap:12px;margin-bottom:26px;}
.spine-logo{flex-shrink:0;}
.wordmark{font-family:var(--font-display);font-weight:700;font-size:19px;letter-spacing:.02em;}
.wordmark small{display:block;font-family:var(--font-mono);font-weight:500;font-size:9.5px;letter-spacing:.22em;color:var(--text-500);margin-top:2px;}
.login-card h1{font-family:var(--font-display);font-size:22px;margin:0 0 6px;font-weight:600;}
.login-sub{color:var(--text-300);font-size:13.5px;margin:0 0 26px;line-height:1.5;}
.field{margin-bottom:16px;}
.field label{display:block;font-family:var(--font-mono);font-size:10.5px;letter-spacing:.12em;color:var(--text-500);text-transform:uppercase;margin-bottom:7px;}
.field input{
  width:100%;background:var(--ink-950);border:1px solid var(--line-700);
  border-radius:7px;padding:11px 13px;color:var(--text-100);font-size:14px;
  transition:border-color .15s, box-shadow .15s;
}
.field input:focus{border-color:var(--blue-500);box-shadow:0 0 0 3px rgba(46,125,255,.15);outline:none;}
.btn-primary{
  width:100%;background:linear-gradient(180deg, var(--blue-500), var(--blue-600));
  border:none;border-radius:7px;padding:12px;color:#fff;font-weight:600;font-size:14px;
  margin-top:6px;letter-spacing:.01em;
  box-shadow:0 8px 20px -8px rgba(46,125,255,.7);
  transition:transform .12s, box-shadow .12s;
}
.btn-primary:hover{transform:translateY(-1px);box-shadow:0 12px 26px -8px rgba(46,125,255,.85);}
.btn-primary:active{transform:translateY(0);}
.login-foot{margin-top:22px;text-align:center;font-size:12px;color:var(--text-500);}
.login-foot a{color:var(--blue-400);text-decoration:none;}
.link-btn{background:none;border:none;padding:0;color:var(--blue-400);font-size:12px;font-family:inherit;text-decoration:underline;text-underline-offset:2px;cursor:pointer;}
.link-btn:hover{color:var(--blue-300);}
.status-strip{
  display:flex;align-items:center;gap:8px;margin-top:24px;padding-top:18px;
  border-top:1px dashed var(--line-700);font-family:var(--font-mono);font-size:10px;color:var(--text-600);letter-spacing:.06em;
}
.dot-pulse{width:6px;height:6px;border-radius:50%;background:var(--good-500);box-shadow:0 0 0 0 rgba(57,214,160,.5);animation:pulseDot 2s infinite;}
@keyframes pulseDot{
  0%{box-shadow:0 0 0 0 rgba(57,214,160,.45);}
  70%{box-shadow:0 0 0 7px rgba(57,214,160,0);}
  100%{box-shadow:0 0 0 0 rgba(57,214,160,0);}
}

/* ============ APP SHELL ============ */
#app-shell{display:grid;grid-template-columns:220px 1fr;min-height:100vh;}

/* Sidebar */
.sidebar{
  border-right:1px solid var(--line-800);
  background:rgba(8,15,24,.55);
  backdrop-filter:blur(4px);
  padding:22px 16px;
  display:flex;flex-direction:column;
  position:sticky;top:0;height:100vh;
}
.sidebar .brand-mark{padding:0 4px;margin-bottom:34px;}
.nav-group-label{font-family:var(--font-mono);font-size:9.5px;letter-spacing:.18em;color:var(--text-600);text-transform:uppercase;padding:0 10px;margin-bottom:8px;}
.nav-list{list-style:none;margin:0 0 28px;padding:0;display:flex;flex-direction:column;gap:2px;}
.nav-item{
  display:flex;align-items:center;gap:11px;padding:10px 11px;border-radius:8px;
  color:var(--text-300);font-size:13.5px;font-weight:500;background:none;border:none;width:100%;text-align:left;
  transition:background .15s, color .15s;position:relative;
}
.nav-item svg{flex-shrink:0;opacity:.75;}
.nav-item:hover{background:var(--ink-800);color:var(--text-100);}
.nav-item.active{background:linear-gradient(90deg, rgba(46,125,255,.16), rgba(46,125,255,.02));color:var(--text-100);}
.nav-item.active svg{opacity:1;stroke:var(--blue-400);}
.nav-item.active::before{content:'';position:absolute;left:-16px;top:8px;bottom:8px;width:3px;background:var(--blue-500);border-radius:0 3px 3px 0;}
.nav-item .tick{margin-left:auto;width:6px;height:6px;border-radius:50%;background:var(--alert-500);display:none;}
.nav-item[data-alert="1"] .tick{display:block;}

.sidebar-foot{margin-top:auto;}
.session-mini{
  border:1px solid var(--line-700);border-radius:10px;padding:12px 12px 11px;background:var(--ink-900);
}
.session-mini .label{font-family:var(--font-mono);font-size:9.5px;color:var(--text-600);letter-spacing:.12em;text-transform:uppercase;margin-bottom:6px;}
.session-mini .value{font-family:var(--font-mono);font-size:15px;color:var(--good-500);font-weight:600;}
.logout-btn{
  width:100%;margin-top:10px;background:none;border:1px solid var(--line-700);color:var(--text-500);
  border-radius:8px;padding:9px;font-size:12.5px;font-weight:500;transition:all .15s;
}
.logout-btn:hover{border-color:var(--alert-500);color:var(--alert-400);}

/* Main */
.main{padding:26px 34px 60px;max-width:1180px;}
.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;gap:20px;flex-wrap:wrap;}
.topbar-title{font-family:var(--font-display);font-size:26px;font-weight:600;letter-spacing:-.01em;}
.topbar-sub{color:var(--text-500);font-size:13px;margin-top:3px;}
.topbar-right{display:flex;align-items:center;gap:16px;}
.clock{
  font-family:var(--font-mono);font-size:12.5px;color:var(--text-300);
  border:1px solid var(--line-700);border-radius:20px;padding:7px 14px;display:flex;align-items:center;gap:8px;
}
.avatar{
  width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,var(--blue-500),var(--blue-600));
  display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-weight:700;font-size:12.5px;
  border:1px solid var(--line-600);
}

.panel{display:none;}
.panel.active{display:block;animation:fadeUp .35s ease both;}
@keyframes fadeUp{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

/* Cards / grid framework */
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
.card{
  background:var(--ink-900);border:1px solid var(--line-800);border-radius:12px;
  position:relative;overflow:hidden;
}
.card::before{
  content:'';position:absolute;inset:0;
  background-image:linear-gradient(rgba(46,125,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(46,125,255,.035) 1px, transparent 1px);
  background-size:22px 22px;pointer-events:none;
}
.card-corner{position:absolute;width:10px;height:10px;border-color:var(--line-600);opacity:.8;pointer-events:none;}
.card-corner.tl{top:8px;left:8px;border-top:1px solid;border-left:1px solid;}
.card-corner.br{bottom:8px;right:8px;border-bottom:1px solid;border-right:1px solid;}

/* Metric tiles */
.metric-tile{padding:18px 18px 16px;}
.metric-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;position:relative;z-index:1;}
.metric-label{font-family:var(--font-mono);font-size:10px;letter-spacing:.1em;color:var(--text-500);text-transform:uppercase;}
.metric-badge{font-family:var(--font-mono);font-size:10px;padding:2px 7px;border-radius:20px;letter-spacing:.04em;}
.metric-badge.good{background:rgba(57,214,160,.12);color:var(--good-500);border:1px solid rgba(57,214,160,.3);}
.metric-badge.warn{background:rgba(255,92,106,.12);color:var(--alert-400);border:1px solid rgba(255,92,106,.3);}
.metric-value{font-family:var(--font-mono);font-size:32px;font-weight:700;position:relative;z-index:1;letter-spacing:-.01em;}
.metric-value span{font-size:14px;color:var(--text-500);font-weight:500;margin-left:3px;}
.metric-foot{font-size:12px;color:var(--text-500);margin-top:6px;position:relative;z-index:1;}
.metric-foot b{color:var(--blue-300);font-weight:600;}

/* Section headers */
.section-head{display:flex;align-items:baseline;justify-content:space-between;margin:30px 0 14px;}
.section-head h2{font-family:var(--font-display);font-size:16px;font-weight:600;margin:0;display:flex;align-items:center;gap:9px;}
.section-head h2::before{content:'';width:5px;height:5px;background:var(--blue-500);border-radius:1px;transform:rotate(45deg);}
.section-head .hint{font-family:var(--font-mono);font-size:10.5px;color:var(--text-600);letter-spacing:.05em;}

/* Chart card */
.chart-card{padding:20px 20px 8px;}
.chart-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px;position:relative;z-index:1;}
.chart-title{font-family:var(--font-display);font-weight:600;font-size:14.5px;}
.chart-range{font-family:var(--font-mono);font-size:10px;color:var(--text-500);}
.chart-current{font-family:var(--font-mono);font-size:20px;font-weight:700;color:var(--blue-300);}
svg.chart{width:100%;height:150px;display:block;position:relative;z-index:1;overflow:visible;}
.chart-axis-labels{display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:9.5px;color:var(--text-600);margin:2px 0 14px;position:relative;z-index:1;}

.insight-box{
  margin:12px 0 16px;padding:13px 14px;border-radius:9px;
  background:linear-gradient(90deg, rgba(46,125,255,.08), rgba(73,211,224,.04));
  border:1px solid rgba(46,125,255,.22);position:relative;z-index:1;
}
.insight-box .tag{font-family:var(--font-mono);font-size:9.5px;letter-spacing:.1em;color:var(--cyan-400);text-transform:uppercase;display:flex;align-items:center;gap:6px;margin-bottom:6px;}
.insight-box p{margin:0;font-size:13px;color:var(--text-300);line-height:1.55;}

/* Record tab */
.rec-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
.cam-panel{padding:0;overflow:hidden;}
.cam-head{display:flex;align-items:center;justify-content:space-between;padding:13px 16px;border-bottom:1px solid var(--line-800);position:relative;z-index:1;}
.cam-name{font-family:var(--font-mono);font-size:11.5px;letter-spacing:.05em;display:flex;align-items:center;gap:8px;}
.cam-status{display:flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:10px;color:var(--good-500);}
.cam-status .dot{width:6px;height:6px;border-radius:50%;background:var(--good-500);animation:pulseDot 2s infinite;}
.cam-view{
  height:250px;position:relative;
  background:radial-gradient(ellipse at 50% 35%, #0e1b2c 0%, #060c14 78%);
  display:flex;align-items:center;justify-content:center;overflow:hidden;
}
.mesh-figure{position:relative;width:120px;height:200px;}
.silhouette{
  position:absolute;inset:0;
  background:linear-gradient(180deg, rgba(46,125,255,.16), rgba(73,211,224,.05));
  clip-path:polygon(38% 0%,62% 0%,70% 10%,66% 24%,74% 30%,84% 60%,78% 100%,58% 90%,52% 100%,22% 100%,16% 60%,26% 30%,34% 24%,30% 10%);
  filter:blur(.3px);
}
.mesh-svg{position:absolute;inset:0;width:100%;height:100%;}
.mesh-svg line, .mesh-svg circle{stroke:var(--blue-400);}
.mesh-svg circle{fill:var(--blue-400);}
.mesh-svg .pulse-node{animation:nodePulse 2.6s ease-in-out infinite;}
@keyframes nodePulse{0%,100%{opacity:.55;}50%{opacity:1;}}
.scan-line{
  position:absolute;left:0;right:0;height:2px;
  background:linear-gradient(90deg, transparent, var(--cyan-400), transparent);
  opacity:.8;animation:scanMove 3.2s linear infinite;
}
@keyframes scanMove{0%{top:8%;}100%{top:92%;}}
.cam-view .no-signal{font-family:var(--font-mono);font-size:11px;color:var(--text-600);letter-spacing:.08em;}
.cam-foot{display:flex;justify-content:space-between;padding:10px 16px;border-top:1px solid var(--line-800);font-family:var(--font-mono);font-size:10.5px;color:var(--text-500);position:relative;z-index:1;}
.cam-foot b{color:var(--text-300);}

.rec-controls{display:flex;align-items:center;gap:16px;margin-top:20px;flex-wrap:wrap;}
.record-btn{
  display:flex;align-items:center;gap:10px;background:linear-gradient(180deg,var(--blue-500),var(--blue-600));
  border:none;color:#fff;font-weight:600;font-size:14px;padding:13px 24px;border-radius:9px;
  box-shadow:0 10px 24px -10px rgba(46,125,255,.8);transition:transform .12s;
}
.record-btn:hover{transform:translateY(-1px);}
.record-btn.recording{background:linear-gradient(180deg,var(--alert-500),#c23241);box-shadow:0 10px 24px -10px rgba(255,92,106,.7);}
.record-btn .rec-dot{width:9px;height:9px;border-radius:50%;background:#fff;}
.record-btn.recording .rec-dot{animation:pulseDot 1.2s infinite;}
.rec-timer{font-family:var(--font-mono);font-size:14px;color:var(--text-300);}
.rec-note{font-size:12px;color:var(--text-500);margin-top:14px;max-width:520px;line-height:1.5;}

.live-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px;}
.live-metric{padding:14px 16px;}
.live-metric .lm-label{font-family:var(--font-mono);font-size:9.5px;color:var(--text-500);letter-spacing:.1em;text-transform:uppercase;position:relative;z-index:1;}
.live-metric .lm-val{font-family:var(--font-mono);font-size:22px;font-weight:700;margin-top:6px;position:relative;z-index:1;}
.bar-track{height:4px;background:var(--line-800);border-radius:3px;margin-top:9px;position:relative;z-index:1;overflow:hidden;}
.bar-fill{height:100%;background:linear-gradient(90deg,var(--blue-500),var(--cyan-400));border-radius:3px;}

/* Export tab */
.export-layout{display:grid;grid-template-columns:1.1fr .9fr;gap:20px;align-items:start;}
.check-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;}
.check-item{
  display:flex;align-items:center;gap:12px;padding:13px 14px;border:1px solid var(--line-800);
  border-radius:9px;background:var(--ink-900);cursor:pointer;transition:border-color .15s,background .15s;
}
.check-item:hover{border-color:var(--line-600);}
.check-item input{accent-color:var(--blue-500);width:16px;height:16px;}
.check-item .ci-text b{display:block;font-size:13.5px;font-weight:600;}
.check-item .ci-text span{display:block;font-size:11.5px;color:var(--text-500);margin-top:1px;}
.range-row{display:flex;gap:10px;margin:16px 0 20px;}
.range-row .field{flex:1;margin:0;}
.pdf-btn{
  display:flex;align-items:center;justify-content:center;gap:10px;width:100%;
  background:linear-gradient(180deg,var(--blue-500),var(--blue-600));border:none;color:#fff;
  font-weight:600;font-size:14px;padding:13px;border-radius:9px;box-shadow:0 10px 24px -10px rgba(46,125,255,.8);
  transition:transform .12s, opacity .15s;
}
.pdf-btn:disabled{opacity:.35;box-shadow:none;cursor:not-allowed;}
.pdf-btn:not(:disabled):hover{transform:translateY(-1px);}
.report-preview{padding:18px;}
.report-sheet{
  background:#0c1520;border:1px solid var(--line-700);border-radius:6px;padding:20px 18px;position:relative;z-index:1;
  font-family:var(--font-mono);
}
.report-sheet .rs-head{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:1px solid var(--line-700);padding-bottom:10px;margin-bottom:12px;}
.report-sheet .rs-head b{font-size:13px;}
.report-sheet .rs-head span{font-size:9.5px;color:var(--text-600);}
.rs-row{display:flex;justify-content:space-between;font-size:11px;color:var(--text-500);padding:5px 0;border-bottom:1px dashed var(--line-800);}
.rs-row b{color:var(--text-300);font-weight:500;}
.rs-block{height:52px;margin:12px 0;border-radius:4px;background:repeating-linear-gradient(135deg, rgba(46,125,255,.08) 0 6px, rgba(46,125,255,.02) 6px 12px);border:1px solid var(--line-800);}

/* Settings tab */
.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
.settings-card{padding:20px;}
.settings-card h3{font-family:var(--font-display);font-size:14.5px;margin:0 0 4px;position:relative;z-index:1;}
.settings-card .sc-sub{font-size:12px;color:var(--text-500);margin:0 0 18px;position:relative;z-index:1;}
.slider-row{margin-bottom:20px;position:relative;z-index:1;}
.slider-row .sr-top{display:flex;justify-content:space-between;font-size:12.5px;margin-bottom:9px;}
.slider-row .sr-top b{font-family:var(--font-mono);color:var(--blue-300);}
input[type=range]{
  -webkit-appearance:none;width:100%;height:4px;border-radius:3px;background:var(--line-700);outline:none;
}
input[type=range]::-webkit-slider-thumb{
  -webkit-appearance:none;width:15px;height:15px;border-radius:50%;background:var(--blue-400);
  border:2px solid var(--ink-950);box-shadow:0 0 0 2px var(--blue-400);cursor:pointer;margin-top:0;
}
.select-row{margin-bottom:16px;position:relative;z-index:1;}
.select-row label{display:block;font-family:var(--font-mono);font-size:10.5px;color:var(--text-500);letter-spacing:.08em;text-transform:uppercase;margin-bottom:7px;}
.select-row select{
  width:100%;background:var(--ink-950);border:1px solid var(--line-700);border-radius:7px;padding:10px 12px;
  color:var(--text-100);font-size:13.5px;
}
.theme-options{display:flex;gap:10px;position:relative;z-index:1;}
.theme-opt{
  flex:1;border:1px solid var(--line-700);border-radius:9px;padding:12px;cursor:pointer;text-align:center;transition:border-color .15s;
}
.theme-opt.selected{border-color:var(--blue-500);background:rgba(46,125,255,.06);}
.theme-opt .swatch{height:26px;border-radius:5px;margin-bottom:8px;}
.theme-opt .swatch.analytical{background:linear-gradient(90deg,#04070b,#2e7dff);}
.theme-opt .swatch.midnight{background:linear-gradient(90deg,#000205,#123a70);}
.theme-opt span{font-size:11.5px;font-weight:500;}
.save-btn{
  margin-top:6px;background:var(--blue-500);color:#fff;border:none;border-radius:8px;padding:11px 22px;
  font-weight:600;font-size:13.5px;transition:transform .12s;
}
.save-btn:hover{transform:translateY(-1px);}

/* Toast */
#toast{
  position:fixed;bottom:24px;right:24px;z-index:50;
  background:var(--ink-850);border:1px solid var(--alert-500);border-radius:11px;
  padding:14px 16px;max-width:320px;display:flex;gap:12px;align-items:flex-start;
  box-shadow:0 20px 50px -15px rgba(0,0,0,.6);
  transform:translateY(20px);opacity:0;pointer-events:none;transition:transform .3s ease, opacity .3s ease;
}
#toast.show{transform:translateY(0);opacity:1;pointer-events:auto;}
#toast .t-icon{width:30px;height:30px;border-radius:8px;background:rgba(255,92,106,.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
#toast .t-text b{display:block;font-size:13px;margin-bottom:2px;}
#toast .t-text span{font-size:12px;color:var(--text-300);line-height:1.4;}
#toast .t-close{background:none;border:none;color:var(--text-600);margin-left:auto;font-size:15px;line-height:1;padding:0;}

/* Responsive */
@media(max-width:980px){
  #app-shell{grid-template-columns:1fr;}
  .sidebar{position:static;height:auto;flex-direction:row;align-items:center;padding:14px 16px;overflow-x:auto;}
